# Copy to .env (gitignored) and fill in. Never commit real values.
# Use a project-only key with a monthly spend limit set in the Anthropic Console.
ANTHROPIC_API_KEY=

# SEC EDGAR requires a User-Agent naming who you are, with a contact email.
# Use a project alias, e.g. "AgentOrchestration research-alias@example.com"
SEC_USER_AGENT=

# Companies House Public Data API key (free): https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Optional override; see docs/decisions/0002-haiku-first-models.md
# DEFAULT_MODEL=claude-haiku-5-5
